# ---- Required everywhere ----
# Discord bot token from the Developer Portal. Must be >=50 chars.
DISCORD_TOKEN=
# Must match the password on the Lavalink node (lavalink/application.yml).
LAVALINK_PASSWORD=
# Postgres password for the `raeon` role. Compose interpolates it into the
# bot's DATABASE_URL; leave it empty and auth fails at runtime, not at start.
DB_PASSWORD=

# ---- Local dev only; docker-compose.yml overrides all of these in-stack ----
DATABASE_URL=
NODE_ENV=development
# Guild to sync slash commands to when NODE_ENV=development.
DEV_GUILD_ID=
# One-shot: wipes all guild-scoped commands on next start.
CLEAR_GUILDS=false
# LAVALINK_HOST=localhost

# ---- Running the bot on your laptop: use .env.local, NOT .env ----
# `cp .env.example .env.local`. .env carries the production token, so booting
# it locally puts a second live instance of the same bot on Discord.
#   DISCORD_TOKEN   a SEPARATE dev-application token
#   LAVALINK_HOST   localhost (node published on 127.0.0.1:2333)
#   DEV_GUILD_ID    guild to sync slash commands to instantly
#   NODE_ENV        development
# `make dev` reads .env.local only.

# ---- Optional; defaults shown ----
# LAVALINK_PORT=2333
# HEALTH_PORT=3000
# LOG_RETENTION_DAYS=30
# LOG_LEVEL=info
