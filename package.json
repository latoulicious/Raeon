{
  "name": "raeon",
  "version": "2.0.5",
  "description": "Production Discord music bot with clean architecture",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major",
    "release:patch-skip-tests": "./scripts/release.sh patch --skip-tests",
    "release:minor-skip-tests": "./scripts/release.sh minor --skip-tests",
    "release:major-skip-tests": "./scripts/release.sh major --skip-tests"
  },
  "keywords": [
    "discord",
    "music",
    "bot",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.1",
    "dotenv": "^17.3.1",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "shoukaku": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "@types/pg": "^8.16.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
