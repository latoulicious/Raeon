[Unit]
Description=Raeon — deploy latest release tag via compose
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/raeon
# First build can take a few minutes; don't let systemd kill it early.
TimeoutStartSec=900
ExecStart=/opt/raeon/deploy/redeploy.sh
